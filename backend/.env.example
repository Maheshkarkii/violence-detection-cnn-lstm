# Backend environment variables for production deployment
# Required - generate a secure random key
SECRET_KEY=your-secret-key-here-min-32-chars-long

# Optional - comma-separated origins (Vercel frontend URL)
ALLOWED_ORIGINS=https://your-app.vercel.app

# Optional - token expiration in minutes (default: 10080 = 7 days)
TOKEN_EXPIRE_MINUTES=10080

# Optional - database path (use /tmp on Render)
DB_PATH=/tmp/violence_detection.db
DB_NAME=users.db

# Optional - model configuration
MODEL_PATH=/opt/vertice/Alert
MODEL_FILE=best_lstm_model_v3.keras